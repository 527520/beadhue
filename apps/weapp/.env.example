# Set these in the shell/CI used by taro build. Empty means local tools only.
WEAPP_API_BASE_URL=https://api.example.com
WEAPP_ASSET_BASE_URL=https://assets.example.com
WEAPP_WEBSITE_URL=https://www.example.com
# Set the real AppID in project.config.json before importing WeChat Developer Tools.
# Never place WECHAT_APP_SECRET or CI upload keys in this workspace.
