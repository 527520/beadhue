# Defaults use the existing Web service. Override in shell/CI for a test service.
# Explicitly empty values keep local tools only.
WEAPP_API_BASE_URL=https://beadhue.com
WEAPP_ASSET_BASE_URL=https://beadhue.com
WEAPP_WEBSITE_URL=https://beadhue.com
# Set the real AppID in project.config.json before importing WeChat Developer Tools.
# Never place WECHAT_APP_SECRET or CI upload keys in this workspace.
