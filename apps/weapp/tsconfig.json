{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "lib": ["ES2020", "DOM"],
    "types": ["@tarojs/taro", "miniprogram-api-typings", "node"],
    "paths": { "@/*": ["../../src/*"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"] }
  },
  "include": ["src", "config", "vitest.config.ts"], "exclude": ["node_modules", "dist"]
}
