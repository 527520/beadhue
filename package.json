{
    "name": "beadhue",
    "version": "0.7.0",
    "private": true,
    "author": "wuqian (https://github.com/527520)",
    "repository": {
        "type": "git",
        "url": "https://github.com/527520/beadhue.git"
    },
    "bugs": {
        "url": "https://github.com/527520/beadhue/issues"
    },
    "scripts": {
        "predev": "node scripts/check-ui-fonts.cjs",
        "dev": "next dev",
        "prebuild": "npm run build:protocol-preflight && node scripts/build-pdf-font-subset.mjs && node scripts/check-ui-fonts.cjs",
        "fonts:check": "node scripts/check-ui-fonts.cjs",
        "build:protocol-preflight": "node scripts/build-protocol-preflight.mjs",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --no-file-parallelism --maxWorkers=1 --project unit --project serial --project integration",
        "test:unit": "vitest run --project unit --project serial",
        "test:integration": "vitest run --project integration",
        "test:postgres-contract": "node tests/postgres/revision-contract.cjs",
        "test:postgres-upgrade": "node tests/postgres/community-upgrade-contract.cjs",
        "test:postgres-governance": "vitest run --config tests/postgres/vitest.config.mts",
        "test:protocol-preflight": "node tests/postgres/protocol-preflight-contract.cjs",
        "test:coverage": "vitest run --no-file-parallelism --maxWorkers=1 --coverage --project unit --project serial --project integration",
        "test:coverage:stable": "node tests/ci/repeat.cjs 5 npm run test:coverage",
        "test:performance": "vitest run --project performance",
        "test:performance:stable": "node tests/ci/repeat.cjs 5 npm run test:performance",
        "test:e2e:check": "node tests/e2e/checkBrowsers.cjs",
        "test:e2e": "npm run test:e2e:check && playwright test",
        "test:e2e:production": "playwright test --config playwright.production.config.mts",
        "test:e2e:stable": "node tests/e2e/stable.cjs 3",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node db/migrate.cjs",
        "brand:check": "node scripts/check-brand.cjs",
        "weapp:dev": "npm run dev -w @beadhue/weapp",
        "weapp:build": "npm run build -w @beadhue/weapp",
        "weapp:typecheck": "npm run typecheck -w @beadhue/weapp",
        "weapp:test": "npm run test -w @beadhue/weapp",
        "test:security:dependencies": "node --test tests/security/braces.test.cjs tests/security/dependency-graph.test.cjs tests/security/standalone-boundary.test.cjs tests/security/taro-native.test.cjs"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@noble/hashes": "^2.4.0",
        "@pdf-lib/fontkit": "^1.1.1",
        "argon2": "^0.45.1",
        "class-variance-authority": "^0.7.1",
        "client-zip": "2.5.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.3",
        "heic2any": "^0.0.4",
        "lucide-react": "^1.47.0",
        "next": "16.3.6",
        "nodemailer": "^10.0.15",
        "pdf-lib": "^1.17.1",
        "pg": "^8.23.1",
        "qr": "0.7.2",
        "react": "^19.2.8",
        "react-day-picker": "10.0.1",
        "react-dom": "^19.2.8",
        "subset-font": "^2.9.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.5",
        "braces": "file:vendor/braces"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@electric-sql/pglite": "^0.5.5",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "axe-core": "^4.13.0",
        "drizzle-kit": "^0.31.10",
        "esbuild": "0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.6",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^30.0.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    },
    "workspaces": [
        "apps/weapp",
        "packages/core"
    ],
    "overrides": {
        "braces": "$braces",
        "@tarojs/components@4.2.1": {
            "swiper": "12.1.2"
        },
        "webpack-dev-server": "5.2.6",
        "webpack-dev-middleware": "7.4.6"
    }
}
