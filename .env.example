# 豆谱环境变量（复制为 .env 后填写；.env 不入库）

# ---- 站点 ----
SITE_DOMAIN=example.com
APP_URL=https://example.com
# 必填：release workflow 已通过完整门禁并推送的稳定 GHCR tag 或 digest；禁止 latest
APP_IMAGE=ghcr.io/527520/doupu:v0.3.0

# ---- 迟迟（chi）：同机第二个应用的 Caddy 站点 ----
# 迟迟是与本仓库并行的独立 compose 项目（/opt/chi），通过 external network
# doupu_default 接入本网络；Caddy 用容器名直连，宿主机不需要为它开放端口。
# 迟迟使用独立 database `chi` 与独立 role `chi`，与本仓库的 doupu 库完全隔离。
CHI_SITE_DOMAIN=chi.example.com
# 迟迟容器名:端口。改过迟迟的 service 名或端口时才需要覆盖。
CHI_UPSTREAM=chi:3200

# ---- 数据库 ----
POSTGRES_DB=doupu
POSTGRES_USER=doupu
# 必填：强随机密码（如 openssl rand -hex 24）
POSTGRES_PASSWORD=
# 容器内互通使用 postgres 主机名；本机开发可用 localhost
DATABASE_URL=postgres://doupu:CHANGE_ME@postgres:5432/doupu

# ---- 邮件（腾讯云 SES API 模板发送：个人实名用户仅可用模板模式） ----
# SES_SECRET_ID=
# SES_SECRET_KEY=
# SES_REGION=ap-guangzhou
# SES_FROM=noreply@example.com
# SES 控制台创建的验证/重置模板 ID（模板内变量用 {{link}}）
# SES_VERIFY_TEMPLATE_ID=
# SES_RESET_TEMPLATE_ID=
# 独立备份告警模板 ID（模板内变量用 {{message}}）。
# 可选：未配置时备份失败告警降级为仅记服务器日志（不拒绝启动、不假报成功）。
# SES_ALERT_TEMPLATE_ID=
# 全局每日发信上限（兜底；建议同时到 SES 控制台设置平台侧日发送上限）
# MAIL_DAILY_SEND_LIMIT=300
# 若改用企业邮箱等其他 SMTP 服务（任选其一）：
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ---- 腾讯云 COS（私有桶，备份与作品原图共用） ----
# 备份写在 doupu-backup/ 前缀，作品原图写在 originals/ 前缀（D49）。
# 桶上不要配自动删除的生命周期规则：原图跟随作品生命周期由应用删除，备份由人工定期清理。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=doupu-1250000000
COS_REGION=ap-guangzhou
# 备份专用子账号密钥（本票 11 新增，必填）：至少给该桶 doupu-backup/ 前缀的读写权限。
# 为什么单独一把：备份任务只需要能写备份前缀，不该同时拿着原图前缀的读写权（上面那把）。
# 留空 = 备份容器启动即失败并发出告警（刻意不回退到 COS_SECRET_ID/KEY，避免静默复用）。
BACKUP_COS_SECRET_ID=
BACKUP_COS_SECRET_KEY=

# ---- 作品原图单独分桶（可选） ----
# 留空则原图沿用上面的 COS_BUCKET 与凭证；只在想把原图放到另一个私有桶 / 子账号 / 地域时填写。
# COS_ORIGINALS_BUCKET=doupu-originals-1250000000
# COS_ORIGINALS_SECRET_ID=
# COS_ORIGINALS_SECRET_KEY=
# COS_ORIGINALS_REGION=ap-guangzhou
# 开发 / E2E 无 COS 时原图落到本机目录（默认 ./.local-originals，已在 .gitignore）
# ORIGINALS_LOCAL_DIR=

# ---- 评论内容安全（D50：腾讯云文本内容安全 TextModeration） ----
# 凭证默认沿用上面的 COS_SECRET_ID / COS_SECRET_KEY（同一套腾讯云 API 密钥），
# 只需在访问管理（CAM）给该子账号追加 tms:TextModeration 权限，不必新建密钥。
# 缺凭证、缺权限或 TMS_ENABLED=false 时：所有评论进入人工待审，不会静默公开。
# 控制台「内容安全 → 文本内容安全 → 策略管理」里的策略编号（BizType）；留空用默认策略
# TMS_BIZ_TYPE=
# 可选：想用另一把子账号密钥 / 另一个地域时再填
# TMS_SECRET_ID=
# TMS_SECRET_KEY=
# TMS_REGION=ap-guangzhou
# TMS_ENABLED=true
# 成本护栏（全部可选）
# TMS_DAILY_BUDGET=2000        # 全站每天最多调用次数，超出后评论转人工
# TMS_CACHE_HOURS=168          # 同文判定缓存小时数，命中不计费
# TMS_TIMEOUT_MS=3000          # 单次调用超时
# RATE_COMMENT_USER_HOUR=20    # 每账号每小时评论上限
# RATE_COMMENT_USER_DAY=80     # 每账号每天评论上限
# RATE_COMMENT_IP_HOUR=60      # 每 IP 每小时评论上限

# ---- 站点配置（全部可选，未设置时用默认值；改配置后重启容器即生效，无需改代码发版） ----
# 生成默认参数
# GEN_DEFAULT_WIDTH=100        # 默认图纸宽度 20–200
# GEN_DEFAULT_COLORS=40        # 默认颜色数 2–128
# PNG 导出默认
# PNG_CELL_PX=24               # 每格像素 8–48
# PNG_CROP_TO_CONTENT=true     # 裁剪至内容
# PNG_INCLUDE_LEGEND=false     # 包含图例
# PDF 打印版式
# PDF_CELL_MM=6                # 每格毫米
# PDF_MARGIN_MM=8              # 页边距毫米
# PDF_HEADER_MM=10             # 页眉高度毫米
# PDF_PAGE_COLS=31             # 每页列数
# PDF_PAGE_ROWS=45             # 每页行数
# 安全阈值
# RATE_LOGIN=10                # 登录限流（次/时/IP+邮箱）
# RATE_REGISTER=10             # 注册限流
# RATE_TOKEN=60                # 验证/重置令牌端点限流
# SESSION_TTL_SECONDS=2592000  # 会话时长（默认 30 天）
# MAX_BODY_BYTES=65536         # 认证端点请求体上限
# RATE_SYNC_WRITE=600          # 同步写（设计/色板 PUT+DELETE）每用户每小时上限
# RATE_BACKUP_ALERT=60         # 备份告警端点每 IP 每小时上限
# RATE_ANALYTICS=300           # 分析摄取每个短期 IP HMAC 键每小时上限
# 豆社反爬与写操作限流（ADR-0021）
# RATE_PUBLIC_READ_IP_HOUR=1200      # 豆社公开读接口（列表/详情/评论/缩略图渲染）每 IP 每小时上限
# RATE_PUBLIC_PAGE_IP_MINUTE=120     # 豆社公开页面（列表/详情/sitemap）每 IP 每分钟上限（进程内计数）
# RATE_COMMUNITY_WRITE_USER_HOUR=120 # 点赞/举报/引用/投稿/原图上传/删评 每账号每小时上限
# RATE_COMMUNITY_WRITE_IP_HOUR=300   # 同上，每 IP 每小时上限
# SITEMAP_RECENT_DAYS=180            # sitemap 只列最近 N 天更新的作品
# SITEMAP_PAGE_SIZE=500              # sitemap 每页作品数
# ---- R14 新增：成本与防爬（admin-round-3 12，全部可选） ----
# RATE_ADMIN_THUMBNAIL_USER_HOUR=20000 # 管理端缩略图每管理员每小时上限（后台不与公开配额争用）
# RATE_ADMIN_ORIGINAL_USER_HOUR=300    # 管理端官方原图上传每管理员每小时上限
# RATE_ORIGINAL_READ_USER_HOUR=60      # 原图下载每账号每小时上限
# RATE_ORIGINAL_READ_IP_HOUR=200       # 原图下载每 IP 每小时上限
# RATE_ACCOUNT_READ_USER_HOUR=1200     # 已登录账号读公开内容每小时上限（IP 之外的第二道闸）
# RATE_ACCOUNT_READ_DISTINCT_WORKS_HOUR=300 # 已登录账号每小时可读的不同作品数上限（防整站抓取）
# RATE_NEW_ACCOUNT_READ_USER_HOUR=120  # 注册 24 小时内账号的读上限
# RATE_NEW_ACCOUNT_READ_DISTINCT_WORKS_HOUR=60
# LOGIN_FAILURE_THRESHOLD=10           # 同一邮箱 15 分钟内失败几次后锁定
# LOGIN_FAILURE_WINDOW_MINUTES=15      # 失败计数窗口（分钟）
# LOGIN_LOCK_MINUTES=15                # 锁定时长（分钟）
# MAIL_DAILY_SEND_LIMIT=200            # 新账号/未验证邮箱的全局每日发信额度
# MAIL_ESTABLISHED_DAILY_LIMIT=100     # 已建立账号（已验证且满 N 天）的保留额度
# MAIL_ESTABLISHED_MIN_AGE_DAYS=7      # 「已建立账号」的最小注册天数
# THUMBNAIL_CACHE_ENTRIES=512          # 缩略图进程缓存条数上限
# THUMBNAIL_CACHE_BYTES=67108864       # 缩略图进程缓存字节上限（默认 64 MiB）
# ORIGINAL_CACHE_BYTES=33554432        # 原图字节缓存上限（默认 32 MiB，0 关闭）
# SITEMAP_CACHE_SECONDS=300            # robots/sitemap 计数与输出缓存秒数
# ---- R14 新增：运行日志与可观测（admin-round-3 13，全部可选） ----
# SLOW_QUERY_MS=500                    # 超过多少毫秒记录慢查询（含调用链；0 关闭）
# SYSLOG_RETENTION_DAYS=30             # 错误日志保留天数
# SLOW_QUERY_RETENTION_DAYS=14         # 慢查询保留天数
# SYSLOG_MAX_ROWS_PER_MINUTE=200       # 每进程每分钟最多写入的日志条数（超出只写一条抑制摘要）
# RATE_CLIENT_ERROR_IP_HOUR=60         # 浏览器错误上报每 IP 每小时上限
# 独立于其他令牌的分析限流 HMAC 密钥（生产必填，至少 32 个随机字符）
ANALYTICS_IP_HMAC_KEY=
# 数据库连接池韧性（0 表示不设该超时）
# DB_POOL_MAX=10               # 连接池上限
# DB_STATEMENT_TIMEOUT_MS=15000 # 单条语句超时
# DB_CONNECTION_TIMEOUT_MS=5000 # 取连接超时
# DB_IDLE_TIMEOUT_MS=30000     # 空闲连接回收

# ---- 备份失败告警（生产必填，缺失时拒绝启动） ----
BACKUP_ALERT_TOKEN=           # 与 backup 容器共享，至少 16 字符（openssl rand -hex 16）
ADMIN_EMAIL=                  # 告警邮件接收邮箱
# ALERT_ENDPOINT=http://app:3000/api/internal/backup-alert   # backup 容器内的告警端点（一般无需改）

# ---- 容器资源上限（本票 11 新增，全部可选：不填即用下列默认值） ----
# 单机小内存服务器的兜底：某一项写错只会让对应容器更早 OOM/被限流，不会静默失效。
# 调参方法与排查见 deploy/CHECKLIST.md「资源上限调参」一节。
# APP_MEM_LIMIT=1g             # app 容器内存上限（Node + argon2）
# APP_CPUS=1.5                 # app 容器 CPU 上限（2 核小机给数据库/Caddy 留余量）
# POSTGRES_MEM_LIMIT=768m      # postgres 内存上限（含 shared_buffers 128MB）
# POSTGRES_PIDS_LIMIT=256      # postgres 进程数上限（每连接一个后端进程）
# CADDY_MEM_LIMIT=256m         # caddy 内存上限
# CADDY_PIDS_LIMIT=256         # caddy 进程数上限
# BACKUP_MEM_LIMIT=512m        # backup 内存上限（pg_dump + gzip）
# BACKUP_PIDS_LIMIT=256        # backup 进程数上限
